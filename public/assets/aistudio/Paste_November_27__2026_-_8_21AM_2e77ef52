    {
      "parameters": {
        "jsCode": "\n/**\n * RAMONA'S HOME\n * Lead Qualification & Appointment Availability Engine\n *\n * FEATURES:\n * 1. Hot, Warm and Cold lead classification\n * 2. Special request financial normalization\n * 3. Accepts combined or separate viewing date/time fields\n * 4. Two-hour appointment availability checking\n * 5. Five nearest alternative appointment suggestions\n * 6. Website success and alternative-time response messages\n *\n * INPUT:\n * Edit Fields + Google Calendar Get Many Events\n *\n * MODE:\n * Run Once for All Items\n */\n\n// ==========================================\n// 1. CONFIGURATION\n// ==========================================\n\nconst customer = $('Edit Fields').first().json;\n\nconst CONFIG = {\n  meetingDurationHours: 2,\n\n  currency: 'CAD',\n\n  timezone: customer.timezone || 'America/Toronto',\n\n  minimumBudget: 5000000,\n  hotBudget: 50000000,\n  warmBudget: 10000000,\n\n  workingHours: {\n    start: 9,\n    end: 17\n  },\n\n  workingDays: [1, 2, 3, 4, 5],\n\n  slotIntervalMinutes: 30,\n\n  alternativesRequired: 5,\n\n  searchDaysBefore: 30,\n  searchDaysAfter: 30\n};\n\nconst calendarItems = $input.all();\n\nconst now = new Date();\n\n\n// ==========================================\n// 2. TIMEZONE UTILITIES\n// ==========================================\n\nfunction getLocalParts(date, timezone) {\n\n  const formatter = new Intl.DateTimeFormat('en-CA', {\n    timeZone: timezone,\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit',\n    weekday: 'short',\n    hourCycle: 'h23'\n  });\n\n  const parts = formatter.formatToParts(date);\n\n  const result = {};\n\n  for (const part of parts) {\n    if (part.type !== 'literal') {\n      result[part.type] = part.value;\n    }\n  }\n\n  return result;\n}\n\n\n// Convert local date/time to UTC using the selected timezone.\n\nfunction localToUTC(year, month, day, hour, minute, timezone) {\n\n  const target = Date.UTC(\n    year,\n    month - 1,\n    day,\n    hour,\n    minute,\n    0\n  );\n\n  let timestamp = target;\n\n  for (let i = 0; i < 3; i++) {\n\n    const parts = getLocalParts(\n      new Date(timestamp),\n      timezone\n    );\n\n    const represented = Date.UTC(\n      Number(parts.year),\n      Number(parts.month) - 1,\n      Number(parts.day),\n      Number(parts.hour),\n      Number(parts.minute),\n      Number(parts.second)\n    );\n\n    timestamp += target - represented;\n  }\n\n  const check = getLocalParts(\n    new Date(timestamp),\n    timezone\n  );\n\n  if (\n    Number(check.year) !== year ||\n    Number(check.month) !== month ||\n    Number(check.day) !== day ||\n    Number(check.hour) !== hour ||\n    Number(check.minute) !== minute\n  ) {\n    throw new Error(\n      'Invalid or ambiguous local appointment time. Please select another time.'\n    );\n  }\n\n  return new Date(timestamp);\n}\n\n\n// ==========================================\n// 3. RETRIEVE AND VALIDATE DATE/TIME\n// ==========================================\n\n// Supports:\n// viewingDateTime: 2026-12-04T11:00:00-05:00\n//\n// OR separate fields:\n// viewingDate: 2026-12-04\n// viewingTime: 11:00 AM\n//\n// Also supports:\n// viewing date / viewing time\n\nlet requestedStart;\n\nconst combinedDateTime = customer.viewingDateTime;\n\nif (combinedDateTime) {\n\n  requestedStart = new Date(combinedDateTime);\n\n} else {\n\n  const viewingDate =\n    customer.viewingDate ||\n    customer['viewing date'];\n\n  const viewingTime =\n    customer.viewingTime ||\n    customer['viewing time'];\n\n  if (!viewingDate || !viewingTime) {\n    throw new Error(\n      'Missing viewing date or viewing time.'\n    );\n  }\n\n  let year;\n  let month;\n  let day;\n\n  const dateString = String(viewingDate).trim();\n\n  // YYYY-MM-DD format\n\n  const isoDate = dateString.match(\n    /^(\\d{4})-(\\d{1,2})-(\\d{1,2})$/\n  );\n\n  // DD/MM/YYYY format\n\n  const canadianDate = dateString.match(\n    /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/\n  );\n\n  if (isoDate) {\n\n    year = Number(isoDate[1]);\n    month = Number(isoDate[2]);\n    day = Number(isoDate[3]);\n\n  } else if (canadianDate) {\n\n    day = Number(canadianDate[1]);\n    month = Number(canadianDate[2]);\n    year = Number(canadianDate[3]);\n\n  } else {\n\n    throw new Error(\n      'Invalid viewing date. Use YYYY-MM-DD or DD/MM/YYYY.'\n    );\n\n  }\n\n  const timeMatch = String(viewingTime).trim().match(\n    /^(\\d{1,2}):(\\d{2})(?:\\s*(AM|PM))?$/i\n  );\n\n  if (!timeMatch) {\n    throw new Error(\n      'Invalid viewing time. Use HH:mm or h:mm AM/PM.'\n    );\n  }\n\n  let hour = Number(timeMatch[1]);\n  const minute = Number(timeMatch[2]);\n\n  const period = timeMatch[3]?.toUpperCase();\n\n  if (period === 'PM' && hour !== 12) {\n    hour += 12;\n  }\n\n  if (period === 'AM' && hour === 12) {\n    hour = 0;\n  }\n\n  if (\n    month < 1 ||\n    month > 12 ||\n    day < 1 ||\n    day > 31 ||\n    hour < 0 ||\n    hour > 23 ||\n    minute < 0 ||\n    minute > 59\n  ) {\n    throw new Error(\n      'Invalid viewing date or time.'\n    );\n  }\n\n  requestedStart = localToUTC(\n    year,\n    month,\n    day,\n    hour,\n    minute,\n    CONFIG.timezone\n  );\n}\n\nif (\n  !requestedStart ||\n  isNaN(requestedStart.getTime())\n) {\n  throw new Error(\n    'Invalid viewing date and time supplied.'\n  );\n}\n\n\n// Calculate the two-hour appointment end time.\n\nconst requestedEnd = new Date(\n  requestedStart.getTime() +\n  CONFIG.meetingDurationHours * 60 * 60 * 1000\n);\n\nconst requestedStartMs = requestedStart.getTime();\nconst requestedEndMs = requestedEnd.getTime();\n\n\n// ==========================================\n// 4. LEAD QUALIFICATION\n// ==========================================\n\nconst budget = Number(customer.budget || 0);\n\nif (!Number.isFinite(budget) || budget < 0) {\n  throw new Error('Invalid customer budget.');\n}\n\n// Default category for leads that do not meet\n// the specific Hot or Cold conditions.\n\nlet leadCategory = 'Warm lead';\n\nconst viewingLocal = getLocalParts(\n  requestedStart,\n  CONFIG.timezone\n);\n\nconst todayLocal = getLocalParts(\n  now,\n  CONFIG.timezone\n);\n\nconst viewingDay = Date.UTC(\n  Number(viewingLocal.year),\n  Number(viewingLocal.month) - 1,\n  Number(viewingLocal.day)\n);\n\nconst todayDay = Date.UTC(\n  Number(todayLocal.year),\n  Number(todayLocal.month) - 1,\n  Number(todayLocal.day)\n);\n\nconst daysUntilViewing = Math.round(\n  (viewingDay - todayDay) / 86400000\n);\n\n\n// Cold: Budget below CAD $5 million.\n\nif (budget < CONFIG.minimumBudget) {\n\n  leadCategory = 'Cold lead';\n\n}\n\n// Hot: Budget CAD $50 million or above,\n// viewing in 1–14 days.\n\nelse if (\n  budget >= CONFIG.hotBudget &&\n  daysUntilViewing >= 1 &&\n  daysUntilViewing <= 14\n) {\n\n  leadCategory = 'Hot lead';\n\n}\n\n// Warm: CAD $5 million to below $50 million,\n// viewing in 21–28 days.\n\nelse if (\n  budget >= CONFIG.minimumBudget &&\n  budget < CONFIG.hotBudget &&\n  daysUntilViewing >= 21 &&\n  daysUntilViewing <= 28\n) {\n\n  leadCategory = 'Warm lead';\n\n}\n\n// Additional Warm rule:\n// Budget of at least CAD $10 million and\n// viewing within one day or 21 days and beyond.\n\nelse if (\n  budget >= CONFIG.warmBudget &&\n  (\n    daysUntilViewing <= 1 ||\n    daysUntilViewing >= 21\n  )\n) {\n\n  leadCategory = 'Warm lead';\n\n}\n\n\n// ==========================================\n// 5. SPECIAL REQUEST NORMALIZATION\n// ==========================================\n\nlet specialRequest = String(\n  customer.moreRequests || ''\n).trim();\n\nspecialRequest = specialRequest.replace(\n  /\\b(\\d+(?:\\.\\d+)?)\\s*([kmb])(?:\\s*CAD)?\\b/gi,\n  (match, amount, suffix) => {\n\n    const multipliers = {\n      k: 1000,\n      m: 1000000,\n      b: 1000000000\n    };\n\n    const normalizedAmount =\n      Number(amount) *\n      multipliers[suffix.toLowerCase()];\n\n    return `${Number(normalizedAmount.toFixed(2))} CAD`;\n  }\n);\n\n\n// ==========================================\n// 6. GOOGLE CALENDAR EVENT PROCESSING\n// ==========================================\n\n// Ignore empty outputs and cancelled events.\n\nconst events = calendarItems\n  .map(item => item.json)\n  .filter(event =>\n    event &&\n    event.start &&\n    event.end &&\n    event.status !== 'cancelled'\n  );\n\n\n// Process timed and all-day events.\n\nfunction getEventRange(event) {\n\n  let start;\n  let end;\n\n  if (event.start.dateTime && event.end.dateTime) {\n\n    start = new Date(event.start.dateTime);\n    end = new Date(event.end.dateTime);\n\n  } else if (event.start.date && event.end.date) {\n\n    const [sy, sm, sd] = event.start.date\n      .split('-')\n      .map(Number);\n\n    const [ey, em, ed] = event.end.date\n      .split('-')\n      .map(Number);\n\n    start = localToUTC(\n      sy, sm, sd, 0, 0, CONFIG.timezone\n    );\n\n    end = localToUTC(\n      ey, em, ed, 0, 0, CONFIG.timezone\n    );\n\n  } else {\n\n    return null;\n\n  }\n\n  if (\n    isNaN(start.getTime()) ||\n    isNaN(end.getTime()) ||\n    end <= start\n  ) {\n    return null;\n  }\n\n  return {\n    start: start.getTime(),\n    end: end.getTime()\n  };\n}\n\nconst busyEvents = events\n  .map(getEventRange)\n  .filter(Boolean);\n\n\n// ==========================================\n// 7. APPOINTMENT OVERLAP CHECK\n// ==========================================\n\nfunction isOverlapping(start, end, event) {\n\n  return (\n    start < event.end &&\n    end > event.start\n  );\n\n}\n\nconst isBooked = busyEvents.some(event =>\n  isOverlapping(\n    requestedStartMs,\n    requestedEndMs,\n    event\n  )\n);\n\nlet appointmentStatus;\n\nlet availableSlots = [];\n\n\n// ==========================================\n// 8. FIND FIVE NEAREST AVAILABLE SLOTS\n// ==========================================\n\nif (!isBooked) {\n\n  appointmentStatus = 'Available Slot';\n\n} else {\n\n  appointmentStatus =\n    'Booked - Alternative Slots Found';\n\n  const localDate = new Date(Date.UTC(\n    Number(viewingLocal.year),\n    Number(viewingLocal.month) - 1,\n    Number(viewingLocal.day)\n  ));\n\n  const candidates = [];\n\n  for (\n    let offset = -CONFIG.searchDaysBefore;\n    offset <= CONFIG.searchDaysAfter;\n    offset++\n  ) {\n\n    const day = new Date(localDate);\n\n    day.setUTCDate(\n      day.getUTCDate() + offset\n    );\n\n    const year = day.getUTCFullYear();\n    const month = day.getUTCMonth() + 1;\n    const date = day.getUTCDate();\n\n    const weekday = day.getUTCDay();\n\n    if (!CONFIG.workingDays.includes(weekday)) {\n      continue;\n    }\n\n    for (\n      let minutes = CONFIG.workingHours.start * 60;\n      minutes +\n        CONFIG.meetingDurationHours * 60 <=\n        CONFIG.workingHours.end * 60;\n      minutes += CONFIG.slotIntervalMinutes\n    ) {\n\n      const hour = Math.floor(minutes / 60);\n      const minute = minutes % 60;\n\n      const slotStart = localToUTC(\n        year,\n        month,\n        date,\n        hour,\n        minute,\n        CONFIG.timezone\n      );\n\n      const slotEnd = new Date(\n        slotStart.getTime() +\n        CONFIG.meetingDurationHours * 60 * 60 * 1000\n      );\n\n      const startMs = slotStart.getTime();\n      const endMs = slotEnd.getTime();\n\n      // Do not suggest appointments in the past.\n\n      if (startMs <= now.getTime()) {\n        continue;\n      }\n\n      // Exclude the original requested appointment.\n\n      if (startMs === requestedStartMs) {\n        continue;\n      }\n\n      // Exclude occupied appointments.\n\n      const occupied = busyEvents.some(event =>\n        isOverlapping(startMs, endMs, event)\n      );\n\n      if (!occupied) {\n\n        candidates.push({\n          start: slotStart,\n          end: slotEnd,\n          distance: Math.abs(\n            startMs - requestedStartMs\n          )\n        });\n\n      }\n    }\n  }\n\n  // Sort by proximity to the requested date/time.\n\n  candidates.sort((a, b) => {\n\n    if (a.distance !== b.distance) {\n      return a.distance - b.distance;\n    }\n\n    return a.start.getTime() - b.start.getTime();\n\n  });\n\n  availableSlots = candidates\n    .slice(0, CONFIG.alternativesRequired)\n    .map((slot, index) => ({\n\n      option: index + 1,\n\n      startTime: slot.start.toISOString(),\n\n      endTime: slot.end.toISOString(),\n\n      viewingDate: getLocalParts(\n        slot.start,\n        CONFIG.timezone\n      ),\n\n      formattedDate: new Intl.DateTimeFormat(\n        'en-CA',\n        {\n          timeZone: CONFIG.timezone,\n          day: '2-digit',\n          month: 'long',\n          year: 'numeric'\n        }\n      ).format(slot.start),\n\n      formattedTime: new Intl.DateTimeFormat(\n        'en-CA',\n        {\n          timeZone: CONFIG.timezone,\n          hour: '2-digit',\n          minute: '2-digit',\n          hour12: true\n        }\n      ).format(slot.start)\n\n    }));\n\n}\n\n\n// ==========================================\n// 9. FORMAT REQUESTED APPOINTMENT\n// ==========================================\n\nconst formattedRequestedDate = new Intl.DateTimeFormat(\n  'en-CA',\n  {\n    timeZone: CONFIG.timezone,\n    day: '2-digit',\n    month: 'long',\n    year: 'numeric'\n  }\n).format(requestedStart);\n\nconst formattedRequestedTime = new Intl.DateTimeFormat(\n  'en-CA',\n  {\n    timeZone: CONFIG.timezone,\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: true\n  }\n).format(requestedStart);\n\n\n// ==========================================\n// 10. WEBSITE RESPONSE DATA\n// ==========================================\n\n// This response is prepared for the website.\n// The final success page should be returned by\n// Respond to Webhook AFTER the calendar and Gmail\n// nodes have completed successfully.\n\nlet pageStatus;\nlet pageTitle;\nlet pageMessage;\n\nif (isBooked) {\n\n  pageStatus = 'alternative_required';\n\n  pageTitle = 'Please choose another viewing time';\n\n  pageMessage =\n    'The date and time you selected are unavailable. Please choose one of the alternative viewing times below.';\n\n} else {\n\n  pageStatus = 'ready_for_confirmation';\n\n  pageTitle = 'Your viewing time is available';\n\n  pageMessage =\n    'Your selected viewing date and time are available. Your request is being processed. Check your inbox for both your calendar and email confirmation once your booking is complete.';\n\n}\n\n\n// ==========================================\n// 11. FINAL OUTPUT\n// ==========================================\n\nreturn [\n  {\n    json: {\n\n      // Preserve normalized customer information.\n\n      ...customer,\n\n      // Lead qualification.\n\n      leadCategory,\n\n      daysUntilViewing,\n\n      // Special request.\n\n      specialRequest,\n\n      // Appointment availability.\n\n      appointmentStatus,\n\n      appointmentAvailable: !isBooked,\n\n      requestedAppointment: {\n\n        startTime: requestedStart.toISOString(),\n\n        endTime: requestedEnd.toISOString(),\n\n        durationHours: CONFIG.meetingDurationHours,\n\n        timezone: CONFIG.timezone,\n\n        formattedDate: formattedRequestedDate,\n\n        formattedTime: formattedRequestedTime\n\n      },\n\n      // Website response.\n\n      pageStatus,\n\n      pageTitle,\n\n      pageMessage,\n\n      // Final success message for Respond to Webhook\n      // after Google Calendar and Gmail succeed.\n\n      successTitle: 'Viewing Date Confirmed!',\n\n      successMessage:\n        'Your property viewing has been successfully scheduled. Check your inbox for both your calendar and email confirmation.',\n\n      successDate: formattedRequestedDate,\n\n      successTime: formattedRequestedTime,\n\n      // Alternative appointments.\n\n      availableSlots,\n\n      availableSlotsCount: availableSlots.length,\n\n      // Calendar diagnostics.\n\n      calendarEventsFound: busyEvents.length\n\n    }\n  }\n];\n"
      },
