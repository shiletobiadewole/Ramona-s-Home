            {
              "id": "76273c4a-52cb-410d-a622-49dc41ca3085",
              "name": "emailbody",
              "value": "=\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <meta name=\"supported-color-schemes\" content=\"light\">\n  <title>Viewing Appointment | Ramona's Home</title>\n\n  <style>\n    body {\n      margin: 0 !important;\n      padding: 0 !important;\n      background-color: #FDFAF0;\n      font-family: Arial, Helvetica, sans-serif;\n      -webkit-text-size-adjust: 100%;\n    }\n\n    table {\n      border-spacing: 0;\n      border-collapse: collapse;\n    }\n\n    img {\n      border: 0;\n      display: block;\n    }\n\n    a {\n      color: #57482D;\n    }\n\n    @media only screen and (max-width: 600px) {\n      .email-wrapper {\n        padding: 15px 8px !important;\n      }\n\n      .email-container {\n        width: 100% !important;\n      }\n\n      .content-padding {\n        padding-left: 22px !important;\n        padding-right: 22px !important;\n      }\n\n      .main-heading {\n        font-size: 26px !important;\n      }\n\n      .detail-label {\n        width: 35% !important;\n      }\n\n      .detail-value {\n        word-break: break-word !important;\n      }\n\n      .appointment-date {\n        font-size: 21px !important;\n      }\n    }\n  </style>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#FDFAF0;\">\n\n  <!-- Hidden email preview -->\n  <div style=\"display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;\">\n    Your property viewing appointment details from Ramona's Home.\n  </div>\n\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#FDFAF0;\">\n    <tr>\n      <td align=\"center\" class=\"email-wrapper\" style=\"padding:35px 15px;\">\n\n        <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-container\" style=\"width:100%; max-width:600px; background-color:#FFFFFF; border:1px solid #E9E2D4;\">\n\n          <!-- Header -->\n          <tr>\n            <td align=\"center\" style=\"padding:38px 25px 32px; background-color:#FDFAF0; border-bottom:1px solid #E9E2D4;\">\n\n              <p style=\"margin:0; color:#57482D; font-size:11px; font-weight:bold; letter-spacing:4px; text-transform:uppercase;\">\n                RAMONA'S HOME\n              </p>\n\n              <table role=\"presentation\" width=\"42\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:19px auto;\">\n                <tr>\n                  <td height=\"2\" style=\"height:2px; background-color:#FADF1E; font-size:0; line-height:0;\">&nbsp;</td>\n                </tr>\n              </table>\n\n              <h1 class=\"main-heading\" style=\"margin:0; font-family:Georgia, 'Times New Roman', serif; font-size:30px; line-height:1.35; font-weight:normal; color:#151513;\">\n                Your Viewing Appointment\n              </h1>\n\n              <p style=\"margin:12px 0 0; font-size:14px; line-height:1.7; color:#878276;\">\n                Let's take the next step towards finding your ideal property.\n              </p>\n\n            </td>\n          </tr>\n\n          <!-- Greeting -->\n          <tr>\n            <td class=\"content-padding\" style=\"padding:32px 38px 20px;\">\n\n              <p style=\"margin:0 0 13px; color:#151513; font-size:15px; line-height:1.7;\">\n                Hello {{ String($('Switch').item.json.fullName || 'there').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;') }},\n              </p>\n\n              <p style=\"margin:0; color:#534F46; font-size:14px; line-height:1.85;\">\n                Thank you for choosing Ramona's Home. We've received your property enquiry and scheduled your viewing appointment. Please review the details below and respond to the calendar invitation to confirm whether the proposed time works for you.\n              </p>\n\n            </td>\n          </tr>\n\n          <!-- Appointment Card -->\n          <tr>\n            <td class=\"content-padding\" style=\"padding:12px 38px 28px;\">\n\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#FCF0D8; border-left:4px solid #57482D;\">\n                <tr>\n                  <td style=\"padding:24px 24px 22px;\">\n\n                    <p style=\"margin:0 0 14px; color:#57482D; font-size:10px; font-weight:bold; letter-spacing:2px; text-transform:uppercase;\">\n                      YOUR APPOINTMENT\n                    </p>\n\n                    <p class=\"appointment-date\" style=\"margin:0 0 8px; color:#151513; font-family:Georgia, 'Times New Roman', serif; font-size:25px; line-height:1.4;\">\n                      {{ $('Switch').item.json['viewing date'] }}\n                    </p>\n\n                    <p style=\"margin:0; color:#534F46; font-size:16px; line-height:1.6;\">\n                      {{ $('Switch').item.json['viewing time'] }}\n                    </p>\n\n                    <p style=\"margin:8px 0 0; color:#878276; font-size:12px; line-height:1.6;\">\n                      {{ (() => {\n                        const data = $('Switch').item.json;\n                        const zone = data.timezone || 'America/Toronto';\n                        const appointment = data.viewingDateTime;\n                        if (!appointment) return zone;\n                        return DateTime.fromISO(appointment, { setZone: true })\n                          .setZone(zone)\n                          .toFormat('ZZZZ') + ' (' + zone + ')';\n                      })() }}\n                    </p>\n\n                    <p style=\"margin:13px 0 0; color:#878276; font-size:12px;\">\n                      Property viewing · 2-hour appointment\n                    </p>\n\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Property Enquiry -->\n          <tr>\n            <td class=\"content-padding\" style=\"padding:0 38px 30px;\">\n\n              <h2 style=\"margin:0 0 16px; color:#151513; font-family:Georgia, 'Times New Roman', serif; font-size:21px; font-weight:normal;\">\n                Your Property Enquiry\n              </h2>\n\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n\n                <tr>\n                  <td class=\"detail-label\" width=\"35%\" style=\"padding:12px 8px 12px 0; border-bottom:1px solid #E9E2D4; color:#878276; font-size:13px;\">\n                    Property Types\n                  </td>\n\n                  <td class=\"detail-value\" style=\"padding:12px 0; border-bottom:1px solid #E9E2D4; color:#151513; font-size:13px; line-height:1.7;\">\n                    {{ String($('Switch').item.json.buildingTypes || 'Not specified').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;') }}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td class=\"detail-label\" style=\"padding:12px 8px 12px 0; border-bottom:1px solid #E9E2D4; color:#878276; font-size:13px;\">\n                    Location\n                  </td>\n\n                  <td class=\"detail-value\" style=\"padding:12px 0; border-bottom:1px solid #E9E2D4; color:#151513; font-size:13px;\">\n                    {{ String($('Switch').item.json.location || 'Not specified').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;') }}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td class=\"detail-label\" style=\"padding:12px 8px 12px 0; border-bottom:1px solid #E9E2D4; color:#878276; font-size:13px;\">\n                    Budget\n                  </td>\n\n                  <td class=\"detail-value\" style=\"padding:12px 0; border-bottom:1px solid #E9E2D4; color:#151513; font-size:13px;\">\n                    {{ (() => {\n                      const value = $('Switch').item.json.budget;\n                      if (value === undefined || value === null || String(value).trim() === '') return 'Not specified';\n                      const amount = Number(String(value).replace(/[^0-9.-]/g, ''));\n                      return Number.isFinite(amount)\n                        ? 'CAD $' + amount.toLocaleString('en-CA', { maximumFractionDigits: 2 })\n                        : String(value);\n                    })() }}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td class=\"detail-label\" style=\"padding:12px 8px 12px 0; border-bottom:1px solid #E9E2D4; color:#878276; font-size:13px; vertical-align:top;\">\n                    Special Request\n                  </td>\n\n                  <td class=\"detail-value\" style=\"padding:12px 0; border-bottom:1px solid #E9E2D4; color:#151513; font-size:13px; line-height:1.7; overflow-wrap:anywhere;\">\n                    {{ String($('Switch').item.json.specialRequest || 'No additional requirements provided.').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;').replace(/\\r\\n|\\r|\\n/g, '<br>') }}\n                  </td>\n                </tr>\n\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Confirmation -->\n          <tr>\n            <td class=\"content-padding\" style=\"padding:0 38px 32px;\">\n\n              <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#FDFAF0; border:1px solid #E9E2D4;\">\n                <tr>\n                  <td style=\"padding:22px 22px;\">\n\n                    <h3 style=\"margin:0 0 10px; color:#151513; font-family:Georgia, 'Times New Roman', serif; font-size:19px; font-weight:normal;\">\n                      Please Confirm Your Availability\n                    </h3>\n\n                    <p style=\"margin:0; color:#534F46; font-size:13px; line-height:1.8;\">\n                      Kindly respond to the calendar invitation with <strong>Yes</strong>, <strong>No</strong> or <strong>Maybe</strong> to let us know whether the scheduled appointment works for you.\n                    </p>\n\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Closing -->\n          <tr>\n            <td class=\"content-padding\" style=\"padding:0 38px 35px;\">\n\n              <p style=\"margin:0 0 17px; color:#534F46; font-size:14px; line-height:1.8;\">\n                We look forward to assisting you with your property search.\n              </p>\n\n              <p style=\"margin:0 0 5px; color:#878276; font-size:13px;\">\n                Kind regards,\n              </p>\n\n              <p style=\"margin:0; color:#151513; font-family:Georgia, 'Times New Roman', serif; font-size:20px;\">\n                Ramona's Home\n              </p>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td align=\"center\" style=\"padding:29px 22px; background-color:#151513;\">\n\n              <p style=\"margin:0 0 13px; color:#FCF0D8; font-size:10px; font-weight:bold; letter-spacing:3px;\">\n                RAMONA'S HOME\n              </p>\n\n              <p style=\"margin:0 0 17px; color:#D2C9B7; font-size:12px; line-height:1.7;\">\n                Have a question about your appointment?\n              </p>\n\n              <p style=\"margin:0 0 13px; font-size:13px;\">\n                <a href=\"tel:+1457567679\" style=\"color:#FADF1E; text-decoration:none;\">\n                  +1 4575 676 79\n                </a>\n              </p>\n\n              <p style=\"margin:0 0 20px; font-size:13px;\">\n                <a href=\"https://ramonashome.pages.dev/\" target=\"_blank\" style=\"color:#FCF0D8; text-decoration:underline;\">\n                  Visit Our Website\n                </a>\n              </p>\n\n              <table role=\"presentation\" width=\"240\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td height=\"1\" style=\"height:1px; background-color:#534F46; font-size:0; line-height:0;\">&nbsp;</td>\n                </tr>\n              </table>\n\n              <p style=\"margin:17px 0 0; color:#878276; font-size:10px; line-height:1.7;\">\n                © Ramona's Home. All rights reserved.\n              </p>\n\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>\n",
              "type": "string"
            }
          ]
