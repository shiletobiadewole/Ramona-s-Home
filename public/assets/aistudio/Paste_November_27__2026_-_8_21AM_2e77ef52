              "value": "=\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Alternative Viewing Times | Ramona's Home</title>\n\n<style>\n:root {\n  --ivory:#FDFAF0;\n  --cream:#FCF0D8;\n  --black:#151513;\n  --taupe:#534F46;\n  --muted:#878276;\n  --border:#B6AF9D;\n  --bronze:#57482D;\n  --deep:#423620;\n  --warning:#FFF1DF;\n  --warning-text:#8B4C14;\n}\n\n* {\n  box-sizing:border-box;\n  margin:0;\n  padding:0;\n}\n\nbody {\n  background:var(--ivory);\n  color:var(--black);\n  font-family:Arial,Helvetica,sans-serif;\n  line-height:1.6;\n  padding:30px 15px;\n}\n\n.container {\n  max-width:680px;\n  margin:auto;\n  background:white;\n  border:1px solid var(--border);\n  border-radius:15px;\n  overflow:hidden;\n  box-shadow:0 12px 35px rgba(0,0,0,.06);\n}\n\n.header {\n  padding:27px 30px;\n  background:var(--ivory);\n  border-bottom:1px solid #e8e1d4;\n}\n\n.brand {\n  font-family:Georgia,serif;\n  font-size:25px;\n  font-weight:bold;\n  letter-spacing:1px;\n}\n\n.brand span {\n  color:var(--bronze);\n}\n\n.brand-caption {\n  color:var(--muted);\n  font-size:10px;\n  letter-spacing:3px;\n  text-transform:uppercase;\n}\n\n.content {\n  padding:32px 30px;\n}\n\n.warning {\n  display:flex;\n  gap:13px;\n  align-items:flex-start;\n  padding:17px;\n  background:var(--warning);\n  border:1px solid #D99B43;\n  border-left:5px solid #C57B21;\n  border-radius:8px;\n  margin-bottom:26px;\n  animation:pulse 2s infinite;\n}\n\n.warning-icon {\n  background:#F4D4A8;\n  color:var(--warning-text);\n  width:29px;\n  height:29px;\n  min-width:29px;\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-weight:bold;\n}\n\n.warning strong {\n  color:var(--warning-text);\n  display:block;\n  font-size:15px;\n  margin-bottom:3px;\n}\n\n.warning p {\n  color:#75502E;\n  font-size:13px;\n}\n\n@keyframes pulse {\n  50% {\n    box-shadow:0 0 0 5px rgba(217,155,67,.16);\n  }\n}\n\nh1 {\n  font-family:Georgia,serif;\n  font-size:32px;\n  font-weight:normal;\n  line-height:1.2;\n  margin-bottom:12px;\n}\n\n.intro {\n  color:var(--taupe);\n  font-size:14px;\n  margin-bottom:25px;\n}\n\n.requested {\n  background:var(--cream);\n  border:1px solid #e8ddc7;\n  border-radius:9px;\n  padding:19px;\n  margin-bottom:30px;\n}\n\n.label {\n  color:var(--muted);\n  font-size:10px;\n  font-weight:bold;\n  letter-spacing:1.3px;\n  text-transform:uppercase;\n  margin-bottom:6px;\n}\n\n.requested-date {\n  font-weight:bold;\n  font-size:17px;\n}\n\n.requested-time {\n  font-size:14px;\n  color:var(--taupe);\n}\n\nh2 {\n  font-family:Georgia,serif;\n  font-weight:normal;\n  font-size:24px;\n  margin-bottom:7px;\n}\n\n.section-description {\n  color:var(--muted);\n  font-size:13px;\n  margin-bottom:19px;\n}\n\n.slot-list {\n  display:grid;\n  gap:12px;\n  margin-bottom:22px;\n}\n\n.slot {\n  display:flex;\n  align-items:center;\n  gap:13px;\n  border:1px solid var(--border);\n  border-radius:9px;\n  padding:16px;\n  cursor:pointer;\n  transition:.2s;\n}\n\n.slot:hover {\n  background:var(--ivory);\n  border-color:var(--bronze);\n}\n\n.slot:has(input:checked) {\n  border:2px solid var(--bronze);\n  background:#FBF6E9;\n  padding:15px;\n}\n\n.slot input {\n  width:18px;\n  height:18px;\n  accent-color:var(--bronze);\n  flex-shrink:0;\n}\n\n.slot-info {\n  flex:1;\n}\n\n.slot-number {\n  display:block;\n  color:var(--muted);\n  font-size:10px;\n  font-weight:bold;\n  letter-spacing:1px;\n  text-transform:uppercase;\n}\n\n.slot-date {\n  display:block;\n  font-size:15px;\n  font-weight:bold;\n  margin-top:3px;\n}\n\n.slot-time {\n  display:block;\n  font-size:13px;\n  color:var(--taupe);\n}\n\n.available {\n  background:#EDF3E8;\n  color:#47653B;\n  border-radius:20px;\n  padding:5px 9px;\n  font-size:10px;\n  font-weight:bold;\n}\n\n.submit {\n  width:100%;\n  background:var(--bronze);\n  color:white;\n  border:0;\n  padding:16px;\n  border-radius:6px;\n  font-size:13px;\n  font-weight:bold;\n  cursor:pointer;\n}\n\n.submit:hover {\n  background:var(--deep);\n}\n\n.submit:disabled {\n  opacity:.5;\n  cursor:not-allowed;\n}\n\n.notice {\n  color:var(--muted);\n  font-size:11px;\n  text-align:center;\n  margin-top:13px;\n}\n\n.footer {\n  background:var(--ivory);\n  border-top:1px solid #e8e1d4;\n  padding:24px;\n  text-align:center;\n}\n\n.footer-brand {\n  font-family:Georgia,serif;\n  font-size:17px;\n  margin-bottom:7px;\n}\n\n.footer p {\n  color:var(--muted);\n  font-size:11px;\n}\n\n.footer a {\n  color:var(--bronze);\n  text-decoration:none;\n}\n\n.feedback {\n  display:none;\n  padding:14px;\n  border-radius:7px;\n  margin-top:16px;\n  font-size:13px;\n}\n\n.feedback.success {\n  display:block;\n  background:#EDF5E9;\n  color:#315B2B;\n}\n\n.feedback.error {\n  display:block;\n  background:#FCEAEA;\n  color:#8B2929;\n}\n\n@media(max-width:520px) {\n  body {padding:12px 8px;}\n  .header {padding:23px 19px;}\n  .content {padding:25px 19px;}\n  h1 {font-size:28px;}\n  .slot {padding:13px;gap:10px;}\n  .slot:has(input:checked) {padding:12px;}\n}\n\n@media(prefers-reduced-motion:reduce) {\n  .warning {animation:none;}\n}\n</style>\n</head>\n\n<body>\n\n<div class=\"container\">\n\n  <header class=\"header\">\n    <div class=\"brand\">RAMONA'S <span>HOME</span></div>\n    <div class=\"brand-caption\">Find a place to call home</div>\n  </header>\n\n  <main class=\"content\">\n\n    <div class=\"warning\">\n      <div class=\"warning-icon\">!</div>\n      <div>\n        <strong>Your selected viewing time is already booked.</strong>\n        <p>Unfortunately, we cannot accommodate your requested time. However, we've found five alternative viewing times for you.</p>\n      </div>\n    </div>\n\n    <h1>Let's find a time that works for you.</h1>\n\n    <p class=\"intro\">\n      Good day {{ $('Edit Fields').first().json.fullName }},\n      thank you for choosing Ramona's Home. We appreciate your interest and would love to arrange a convenient time for your property viewing. Please choose one of the available alternatives below.\n    </p>\n\n    <div class=\"requested\">\n      <div class=\"label\">Your originally requested appointment</div>\n\n      <div class=\"requested-date\">\n        {{ $('Edit Fields').first().json['viewing date'] }}\n      </div>\n\n      <div class=\"requested-time\">\n        {{ $('Edit Fields').first().json['viewing time'] }}\n      </div>\n    </div>\n\n    <h2>Choose an available viewing time</h2>\n\n    <p class=\"section-description\">\n      We've identified the following five alternative appointments. Select the time that best fits your schedule.\n    </p>\n\n    <form id=\"appointmentForm\">\n\n      <div class=\"slot-list\">\n        {{\n          $('Code in JavaScript').first().json.availableSlots.slice(0,5).map((slot,index) => `\n            <label class=\"slot\">\n              <input type=\"radio\" name=\"selectedSlot\" value=\"${index}\" required>\n\n              <span class=\"slot-info\">\n                <span class=\"slot-number\">Alternative slot ${index + 1}</span>\n                <span class=\"slot-date\">${slot.formattedDate}</span>\n                <span class=\"slot-time\">Time: ${slot.formattedTime}</span>\n              </span>\n\n              <span class=\"available\">AVAILABLE</span>\n            </label>\n          `).join('')\n        }}\n      </div>\n\n      <button type=\"submit\" class=\"submit\" id=\"submitButton\">\n        CONFIRM MY PREFERRED TIME\n      </button>\n\n      <p class=\"notice\">\n        Your selected time will be checked again before your appointment is confirmed.\n      </p>\n\n      <div id=\"feedback\" class=\"feedback\" role=\"status\" aria-live=\"polite\"></div>\n\n    </form>\n\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"footer-brand\">Ramona's Home</div>\n    <p>We're here to help you find a place to call home.</p>\n\n    <p style=\"margin-top:10px\">\n      <a href=\"https://ramonashome.pages.dev/\">Visit our website</a>\n      &nbsp; | &nbsp;\n      <a href=\"mailto:enquiry@ramonashome.com\">Contact our team</a>\n    </p>\n\n    <p style=\"margin-top:14px\">© 2026 Ramona's Home. All rights reserved.</p>\n  </footer>\n\n</div>\n\n<script>\nconst availableSlots = {{ JSON.stringify(\n  $('Code in JavaScript').first().json.availableSlots.slice(0,5)\n).replace(/</g, '\\\\u003c') }};\n\nconst customer = {\n  fullName: {{ JSON.stringify($('Edit Fields').first().json.fullName) }},\n  email: {{ JSON.stringify($('Edit Fields').first().json.email) }},\n  phone: {{ JSON.stringify($('Edit Fields').first().json.phone) }}\n};\n\nconst timezone = {{ JSON.stringify($('Edit Fields').first().json.timezone || 'America/Vancouver') }};\n\n// Replace this with your second n8n webhook production URL.\nconst submissionWebhook = 'YOUR_SECOND_N8N_WEBHOOK_URL';\n\nconst form = document.getElementById('appointmentForm');\nconst button = document.getElementById('submitButton');\nconst feedback = document.getElementById('feedback');\n\nform.addEventListener('submit', async (event) => {\n  event.preventDefault();\n\n  const selected = document.querySelector(\n    'input[name=\"selectedSlot\"]:checked'\n  );\n\n  if (!selected) {\n    feedback.textContent = 'Please select one of the available appointments.';\n    feedback.className = 'feedback error';\n    return;\n  }\n\n  if (submissionWebhook === 'YOUR_SECOND_N8N_WEBHOOK_URL') {\n    feedback.textContent = 'The appointment submission service has not yet been connected.';\n    feedback.className = 'feedback error';\n    return;\n  }\n\n  const index = Number(selected.value);\n  const slot = availableSlots[index];\n\n  if (!slot || !slot.startTime || !slot.endTime) {\n    feedback.textContent = 'Invalid appointment selection. Please refresh the page.';\n    feedback.className = 'feedback error';\n    return;\n  }\n\n  button.disabled = true;\n  button.textContent = 'SUBMITTING...';\n\n  try {\n    const response = await fetch(submissionWebhook, {\n      method: 'POST',\n      headers: {\n        'Content-Type':'application/json'\n      },\n      body: JSON.stringify({\n        fullName: customer.fullName,\n        email: customer.email,\n        phone: customer.phone,\n        selectedSlotIndex: index,\n        selectedSlotStart: slot.startTime,\n        selectedSlotEnd: slot.endTime,\n        viewingDate: slot.viewingDate,\n        formattedDate: slot.formattedDate,\n        formattedTime: slot.formattedTime,\n        timezone: timezone\n      })\n    });\n\n    if (!response.ok) {\n      throw new Error('Submission failed');\n    }\n\n    feedback.textContent =\n      'Thank you! Your preferred viewing time has been submitted. Our team will verify its availability and contact you with confirmation.';\n\n    feedback.className = 'feedback success';\n    button.textContent = 'SELECTION SUBMITTED';\n\n  } catch (error) {\n    feedback.textContent =\n      'We could not submit your selection. Please try again or contact enquiry@ramonashome.com.';\n\n    feedback.className = 'feedback error';\n    button.disabled = false;\n    button.textContent = 'CONFIRM MY PREFERRED TIME';\n  }\n});\n</script>\n\n</body>\n</html>\n",
