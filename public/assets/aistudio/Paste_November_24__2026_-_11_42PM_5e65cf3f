    {
      "parameters": {
        "jsCode": "\n/**\n * RAMONAS HOUSE\n * Lead Qualification & Appointment Availability Engine\n *\n * Features:\n * 1. Hot, Warm and Cold lead classification\n * 2. Special request financial normalization\n * 3. Two-hour appointment availability checking\n * 4. Five nearest alternative appointment suggestions\n *\n * Input:\n * Edit Fields + Get many events (Google Calendar)\n *\n * Code Node Mode:\n * Run Once for All Items\n */\n\n// ==========================================\n// 1. CONFIGURATION\n// ==========================================\n\nconst CONFIG = {\n  meetingDurationHours: 2,\n\n  currency: 'CAD',\n\n  timezone: $('Edit Fields').first().json.timezone || 'America/Toronto',\n\n  minimumBudget: 5000000,\n  hotBudget: 50000000,\n  warmBudget: 10000000,\n\n  workingHours: {\n    start: 9,\n    end: 17\n  },\n\n  workingDays: [1, 2, 3, 4, 5], // Monday-Friday\n\n  slotIntervalMinutes: 30,\n\n  alternativesRequired: 5,\n\n  searchDaysBefore: 30,\n  searchDaysAfter: 30\n};\n\n\n// ==========================================\n// 2. RETRIEVE CUSTOMER DATA\n// ==========================================\n\nconst customer = $('Edit Fields').first().json;\n\nconst calendarItems = $input.all();\n\nconst requestedDateTime = customer.viewingDateTime;\n\nif (!requestedDateTime) {\n  throw new Error('Missing customer viewingDateTime.');\n}\n\nconst requestedStart = new Date(requestedDateTime);\n\nif (isNaN(requestedStart.getTime())) {\n  throw new Error('Invalid viewingDateTime supplied.');\n}\n\nconst requestedEnd = new Date(\n  requestedStart.getTime() +\n  CONFIG.meetingDurationHours * 60 * 60 * 1000\n);\n\nconst now = new Date();\n\n\n// ==========================================\n// 3. TIMEZONE UTILITIES\n// ==========================================\n\nfunction getLocalParts(date, timezone) {\n\n  const formatter = new Intl.DateTimeFormat('en-CA', {\n    timeZone: timezone,\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit',\n    weekday: 'short',\n    hourCycle: 'h23'\n  });\n\n  const parts = formatter.formatToParts(date);\n\n  const result = {};\n\n  for (const part of parts) {\n    if (part.type !== 'literal') {\n      result[part.type] = part.value;\n    }\n  }\n\n  return result;\n}\n\n\n// Convert a local calendar date and time into UTC.\n// Handles daylight-saving-time offsets using the IANA timezone.\n\nfunction localToUTC(year, month, day, hour, minute, timezone) {\n\n  const target = Date.UTC(\n    year, month - 1, day, hour, minute, 0\n  );\n\n  let timestamp = target;\n\n  for (let i = 0; i < 3; i++) {\n\n    const parts = getLocalParts(\n      new Date(timestamp),\n      timezone\n    );\n\n    const represented = Date.UTC(\n      Number(parts.year),\n      Number(parts.month) - 1,\n      Number(parts.day),\n      Number(parts.hour),\n      Number(parts.minute),\n      Number(parts.second)\n    );\n\n    timestamp += target - represented;\n  }\n\n  const check = getLocalParts(\n    new Date(timestamp),\n    timezone\n  );\n\n  if (\n    Number(check.year) !== year ||\n    Number(check.month) !== month ||\n    Number(check.day) !== day ||\n    Number(check.hour) !== hour ||\n    Number(check.minute) !== minute\n  ) {\n    throw new Error(\n      'Invalid or ambiguous local appointment time.'\n    );\n  }\n\n  return new Date(timestamp);\n}\n\n\n// ==========================================\n// 4. LEAD QUALIFICATION\n// ==========================================\n\nconst budget = Number(customer.budget || 0);\n\nif (!Number.isFinite(budget) || budget < 0) {\n  throw new Error('Invalid customer budget.');\n}\n\nconst viewingLocal = getLocalParts(\n  requestedStart,\n  CONFIG.timezone\n);\n\nconst todayLocal = getLocalParts(\n  now,\n  CONFIG.timezone\n);\n\n// Compare local calendar dates rather than raw hours.\n\nconst viewingDay = Date.UTC(\n  Number(viewingLocal.year),\n  Number(viewingLocal.month) - 1,\n  Number(viewingLocal.day)\n);\n\nconst todayDay = Date.UTC(\n  Number(todayLocal.year),\n  Number(todayLocal.month) - 1,\n  Number(todayLocal.day)\n);\n\nconst daysUntilViewing = Math.round(\n  (viewingDay - todayDay) / 86400000\n);\n\nlet leadCategory = 'Warm';\n\n// Cold: Below $5 million, regardless of date.\n\nif (budget < CONFIG.minimumBudget) {\n\n  leadCategory = 'Cold lead';\n\n}\n\n// Hot: $50 million or above, viewing in 1–14 days.\n\nelse if (\n  budget >= CONFIG.hotBudget &&\n  daysUntilViewing >= 1 &&\n  daysUntilViewing <= 14\n) {\n\n  leadCategory = 'Hot lead';\n\n}\n\n// Warm: $5m–$49,999,999, viewing in 21–28 days.\n\nelse if (\n  budget >= CONFIG.minimumBudget &&\n  budget < CONFIG.hotBudget &&\n  daysUntilViewing >= 21 &&\n  daysUntilViewing <= 28\n) {\n\n  leadCategory = 'Warm lead';\n\n}\n\n// Additional Warm rule:\n// Budget of $10m or more and viewing within 1 day\n// or 3 weeks and beyond.\n\nelse if (\n  budget >= CONFIG.warmBudget &&\n  (\n    daysUntilViewing <= 1 ||\n    daysUntilViewing >= 21\n  )\n) {\n\n  leadCategory = 'Warm lead';\n\n}\n\n// Leads that do not meet any specified criteria\n// remain Warm as a default pending further review.\n\n\n// ==========================================\n// 5. SPECIAL REQUEST NORMALIZATION\n// ==========================================\n\nlet specialRequest = String(\n  customer.moreRequests || ''\n).trim();\n\n// Convert abbreviated financial amounts:\n//\n// 1k CAD  -> 1000 CAD\n// 10k CAD -> 10000 CAD\n// 1m CAD  -> 1000000 CAD\n// 50m     -> 50000000 CAD\n// 1.5m    -> 1500000 CAD\n//\n// Only numbers with k, m or b suffixes are changed.\n// Ordinary numbers such as 2 bedrooms remain unchanged.\n\nspecialRequest = specialRequest.replace(\n  /\\b(\\d+(?:\\.\\d+)?)\\s*([kmb])(?:\\s*CAD)?\\b/gi,\n  (match, amount, suffix) => {\n\n    const multipliers = {\n      k: 1000,\n      m: 1000000,\n      b: 1000000000\n    };\n\n    const normalizedAmount =\n      Number(amount) *\n      multipliers[suffix.toLowerCase()];\n\n    return `${Number(normalizedAmount.toFixed(2))} CAD`;\n  }\n);\n\n\n// ==========================================\n// 6. GOOGLE CALENDAR EVENT PROCESSING\n// ==========================================\n\n// Ignore empty outputs and cancelled events.\n\nconst events = calendarItems\n  .map(item => item.json)\n  .filter(event =>\n    event &&\n    event.start &&\n    event.end &&\n    event.status !== 'cancelled'\n  );\n\n\n// Handle both timed and all-day calendar events.\n\nfunction getEventRange(event) {\n\n  let start;\n  let end;\n\n  if (event.start.dateTime) {\n\n    start = new Date(event.start.dateTime);\n\n    end = new Date(event.end.dateTime);\n\n  } else if (event.start.date && event.end.date) {\n\n    const [sy, sm, sd] = event.start.date\n      .split('-').map(Number);\n\n    const [ey, em, ed] = event.end.date\n      .split('-').map(Number);\n\n    start = localToUTC(\n      sy, sm, sd, 0, 0, CONFIG.timezone\n    );\n\n    end = localToUTC(\n      ey, em, ed, 0, 0, CONFIG.timezone\n    );\n\n  } else {\n\n    return null;\n\n  }\n\n  if (\n    isNaN(start.getTime()) ||\n    isNaN(end.getTime()) ||\n    end <= start\n  ) {\n    return null;\n  }\n\n  return {\n    start: start.getTime(),\n    end: end.getTime()\n  };\n}\n\nconst busyEvents = events\n  .map(getEventRange)\n  .filter(Boolean);\n\n\n// Check whether two appointments overlap.\n\nfunction isOverlapping(start, end, event) {\n\n  return (\n    start < event.end &&\n    end > event.start\n  );\n\n}\n\n\n// ==========================================\n// 7. CHECK REQUESTED APPOINTMENT\n// ==========================================\n\nconst requestedStartMs = requestedStart.getTime();\n\nconst requestedEndMs = requestedEnd.getTime();\n\nconst isBooked = busyEvents.some(event =>\n  isOverlapping(\n    requestedStartMs,\n    requestedEndMs,\n    event\n  )\n);\n\nlet appointmentStatus;\n\nlet availableSlots = [];\n\n\n// ==========================================\n// 8. FIND FIVE NEAREST AVAILABLE SLOTS\n// ==========================================\n\nif (!isBooked) {\n\n  appointmentStatus = 'Available Slot';\n\n} else {\n\n  appointmentStatus = 'Booked - Alternative Slots Found';\n\n  const localDate = new Date(Date.UTC(\n    Number(viewingLocal.year),\n    Number(viewingLocal.month) - 1,\n    Number(viewingLocal.day)\n  ));\n\n  const candidates = [];\n\n  for (\n    let offset = -CONFIG.searchDaysBefore;\n    offset <= CONFIG.searchDaysAfter;\n    offset++\n  ) {\n\n    const day = new Date(localDate);\n\n    day.setUTCDate(day.getUTCDate() + offset);\n\n    const year = day.getUTCFullYear();\n    const month = day.getUTCMonth() + 1;\n    const date = day.getUTCDate();\n\n    const weekday = day.getUTCDay();\n\n    // Skip weekends and non-working days.\n\n    if (!CONFIG.workingDays.includes(weekday)) {\n      continue;\n    }\n\n    // Generate appointments every 30 minutes.\n\n    for (\n      let minutes = CONFIG.workingHours.start * 60;\n      minutes + CONFIG.meetingDurationHours * 60 <=\n        CONFIG.workingHours.end * 60;\n      minutes += CONFIG.slotIntervalMinutes\n    ) {\n\n      const hour = Math.floor(minutes / 60);\n\n      const minute = minutes % 60;\n\n      const slotStart = localToUTC(\n        year,\n        month,\n        date,\n        hour,\n        minute,\n        CONFIG.timezone\n      );\n\n      const slotEnd = new Date(\n        slotStart.getTime() +\n        CONFIG.meetingDurationHours * 60 * 60 * 1000\n      );\n\n      const startMs = slotStart.getTime();\n\n      const endMs = slotEnd.getTime();\n\n      // Do not suggest appointments in the past.\n\n      if (startMs <= now.getTime()) {\n        continue;\n      }\n\n      // Exclude the original requested slot.\n\n      if (startMs === requestedStartMs) {\n        continue;\n      }\n\n      // Check all existing calendar appointments.\n\n      const occupied = busyEvents.some(event =>\n        isOverlapping(startMs, endMs, event)\n      );\n\n      if (!occupied) {\n\n        candidates.push({\n          start: slotStart,\n          end: slotEnd,\n          distance: Math.abs(\n            startMs - requestedStartMs\n          )\n        });\n\n      }\n\n    }\n\n  }\n\n  // Rank by closeness to the requested appointment.\n\n  candidates.sort((a, b) => {\n\n    if (a.distance !== b.distance) {\n      return a.distance - b.distance;\n    }\n\n    return a.start.getTime() - b.start.getTime();\n\n  });\n\n  availableSlots = candidates\n    .slice(0, CONFIG.alternativesRequired)\n    .map((slot, index) => ({\n\n      option: index + 1,\n\n      startTime: slot.start.toISOString(),\n\n      endTime: slot.end.toISOString(),\n\n      viewingDate: getLocalParts(\n        slot.start,\n        CONFIG.timezone\n      ),\n\n      formattedDate: new Intl.DateTimeFormat(\n        'en-CA',\n        {\n          timeZone: CONFIG.timezone,\n          day: '2-digit',\n          month: 'long',\n          year: 'numeric'\n        }\n      ).format(slot.start),\n\n      formattedTime: new Intl.DateTimeFormat(\n        'en-CA',\n        {\n          timeZone: CONFIG.timezone,\n          hour: '2-digit',\n          minute: '2-digit',\n          hour12: true\n        }\n      ).format(slot.start)\n\n    }));\n\n}\n\n\n// ==========================================\n// 9. FINAL OUTPUT\n// ==========================================\n\nreturn [\n  {\n    json: {\n\n      // Preserve normalized customer information.\n\n      ...customer,\n\n      // Lead qualification.\n\n      leadCategory,\n\n      daysUntilViewing,\n\n      // Special request.\n\n      specialRequest,\n\n      // Appointment information.\n\n      appointmentStatus,\n\n      requestedAppointment: {\n        startTime: requestedStart.toISOString(),\n        endTime: requestedEnd.toISOString(),\n        durationHours: CONFIG.meetingDurationHours,\n        timezone: CONFIG.timezone\n      },\n\n      // Alternative appointments.\n\n      availableSlots,\n\n      availableSlotsCount: availableSlots.length,\n\n      // Calendar diagnostics.\n\n      calendarEventsFound: busyEvents.length\n\n    }\n  }\n];\n"
      },
